REBOL [
	Title:   "Home Video 20 - bitmap font atlas"
	Name:    homevideo-20
	Purpose: {
		The Home Video font rendered at 20 pixels - crisp, one font pixel is one image pixel -
		as a texture atlas for Rebol-Pugl. Generated from HomeVideo.ttf by
		font-atlas.py; the atlas is embedded compressed, so no image codec
		is needed.

		    font: make-font do %homevideo-20.reb
	}
	Note: {Creative Commons Zero v1.0 Universal}
]

make object! [
	name:        "Home Video"
	size:        20
	line-height: 18     ;; ascent, descent and the font's line gap
	ascent:      16     ;; from the line's top to the baseline
	descent:     2


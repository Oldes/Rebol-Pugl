REBOL [
	Title:   "Ubuntu 15 - bitmap font atlas"
	Name:    ubuntu-15
	Purpose: {
		The Ubuntu font rendered at 15 pixels -
		as a texture atlas for Rebol-Pugl. Generated from Ubuntu.ttf by
		font-atlas.py; the atlas is embedded compressed, so no image codec
		is needed.

		    font: make-font do %font/ubuntu-15.reb
	}
	Note: {Copyright 2011 Canonical Ltd.  Licensed under the Ubuntu Font Licence 1.0 - Check the font's licence before redistributing it}
]

make object! [
	name:        "Ubuntu"
	size:        15
	line-height: 18     ;; ascent, descent and the font's line gap
	ascent:      15     ;; from the line's top to the baseline
	descent:     3

	;; White glyphs on transparent - colour them with `tint`. 1 pixel apart,
	;; so even `filter: 'linear` does not bleed between them. 1462 ink pixels.
	atlas: make image! 256x146   ;; white by default

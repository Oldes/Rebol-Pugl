REBOL [
	Title:   "Midnight Letters 20.48 - bitmap font atlas"
	Name:    midnight-20
	Purpose: {
		The Midnight Letters font rendered at 20.48 pixels - crisp, one font pixel is one image pixel -
		as a texture atlas for Rebol-Pugl. Generated from MidnightLetters.ttf by
		font-atlas.py; the atlas is embedded compressed, so no image codec
		is needed.

		    font: make-font do %font/midnight-20.reb
	}
	Note: {© 2024 GGBotNet. All Rights Reserved. - This Font Software is licensed under the SIL Open Font License, Version 1.1. This license is available with a FAQ at: https://scripts.sil.org/OFL}
]

make object! [
	name:        "Midnight Letters"
	size:        20.48
	line-height: 25     ;; ascent, descent and the font's line gap
	ascent:      20     ;; from the line's top to the baseline
	descent:     5


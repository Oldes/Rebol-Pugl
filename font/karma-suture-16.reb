REBOL [
	Title:   "Karma Suture 15.83 - bitmap font atlas"
	Name:    karma-suture-16
	Purpose: {
		The Karma Suture font rendered at 15.83 pixels - crisp, one font pixel is one image pixel -
		as a texture atlas for Rebol-Pugl. Generated from KarmaSuture.otf by
		font-atlas.py; the atlas is embedded compressed, so no image codec
		is needed.

		    font: make-font do %font/karma-suture-16.reb
	}
	Note: {Released in 2022 under CC0 license. No rights reserved. - Check the font's licence before redistributing it}
]

make object! [
	name:        "Karma Suture"
	size:        15.83
	line-height: 19     ;; ascent, descent and the font's line gap
	ascent:      16     ;; from the line's top to the baseline
	descent:     3


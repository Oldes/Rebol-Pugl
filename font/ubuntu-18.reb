REBOL [
	Title:   "Ubuntu 18 - bitmap font atlas"
	Name:    ubuntu-18
	Purpose: {
		The Ubuntu font rendered at 18 pixels -
		as a texture atlas for Rebol-Pugl. Generated from Ubuntu.ttf by
		font-atlas.py; the atlas is embedded compressed, so no image codec
		is needed.

		    font: make-font do %font/ubuntu-18.reb
	}
	Note: {Copyright 2011 Canonical Ltd.  Licensed under the Ubuntu Font Licence 1.0 - Check the font's licence before redistributing it}
]

make object! [
	name:        "Ubuntu"
	size:        18
	line-height: 22     ;; ascent, descent and the font's line gap
	ascent:      17     ;; from the line's top to the baseline
	descent:     4

	;; White glyphs on transparent - colour them with `tint`. 1 pixel apart,
	;; so even `filter: 'linear` does not bleed between them. 3538 ink pixels.
	atlas: make image! 256x184   ;; white by default

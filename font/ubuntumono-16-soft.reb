REBOL [
	Title:   "Ubuntu Mono 16 - bitmap font atlas"
	Name:    ubuntumono-16-soft
	Purpose: {
		The Ubuntu Mono font rendered at 16 pixels -
		as a texture atlas for Rebol-Pugl. Generated from UbuntuMono.ttf by
		font-atlas.py; the atlas is embedded compressed, so no image codec
		is needed.

		    font: make-font do %ubuntumono-16-soft.reb
	}
	Note: {Copyright 2011 Canonical Ltd.  Licensed under the Ubuntu Font Licence 1.0 - Check the font's licence before redistributing it}
]

make object! [
	name:        "Ubuntu Mono"
	size:        16
	line-height: 17     ;; ascent, descent and the font's line gap
	ascent:      14     ;; from the line's top to the baseline
	descent:     3

	;; White glyphs on transparent - colour them with `tint`. 1 pixel apart,
	;; so even `filter: 'linear` does not bleed between them. 1642 ink pixels.
	atlas: make image! 256x125   ;; white by default

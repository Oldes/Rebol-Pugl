REBOL [
	Title:   "Ubuntu 12 - bitmap font atlas"
	Name:    ubuntu-12
	Purpose: {
		The Ubuntu font rendered at 12 pixels -
		as a texture atlas for Rebol-Pugl. Generated from Ubuntu.ttf by
		font-atlas.py; the atlas is embedded compressed, so no image codec
		is needed.

		    font: make-font do %font/ubuntu-12.reb
	}
	Note: {Copyright 2011 Canonical Ltd.  Licensed under the Ubuntu Font Licence 1.0 - Check the font's licence before redistributing it}
]

make object! [
	name:        "Ubuntu"
	size:        12
	line-height: 15     ;; ascent, descent and the font's line gap
	ascent:      12     ;; from the line's top to the baseline
	descent:     3

	;; White glyphs on transparent - colour them with `tint`. 1 pixel apart,
	;; so even `filter: 'linear` does not bleed between them. 1071 ink pixels.
	atlas: make image! 256x97   ;; white by default

REBOL [
	Title:   "Ubuntu 13 - bitmap font atlas"
	Name:    ubuntu-13
	Purpose: {
		The Ubuntu font rendered at 13 pixels -
		as a texture atlas for Rebol-Pugl. Generated from Ubuntu.ttf by
		font-atlas.py; the atlas is embedded compressed, so no image codec
		is needed.

		    font: make-font do %font/ubuntu-13.reb
	}
	Note: {Copyright 2011 Canonical Ltd.  Licensed under the Ubuntu Font Licence 1.0 - Check the font's licence before redistributing it}
]

make object! [
	name:        "Ubuntu"
	size:        13
	line-height: 16     ;; ascent, descent and the font's line gap
	ascent:      13     ;; from the line's top to the baseline
	descent:     3


REBOL [
	Title:   "Ubuntu 16 - bitmap font atlas"
	Name:    ubuntu-16
	Purpose: {
		The Ubuntu font rendered at 16 pixels -
		as a texture atlas for Rebol-Pugl. Generated from Ubuntu.ttf by
		font-atlas.py; the atlas is embedded compressed, so no image codec
		is needed.

		    font: make-font do %font/ubuntu-16.reb
	}
	Note: {Copyright 2011 Canonical Ltd.  Licensed under the Ubuntu Font Licence 1.0 - Check the font's licence before redistributing it}
]

make object! [
	name:        "Ubuntu"
	size:        16
	line-height: 20     ;; ascent, descent and the font's line gap
	ascent:      16     ;; from the line's top to the baseline
	descent:     4

	;; White glyphs on transparent - colour them with `tint`. 1 pixel apart,
	;; so even `filter: 'linear` does not bleed between them. 1808 ink pixels.
	atlas: make image! 256x157   ;; white by default

REBOL [
	Title:   "Pixeloid Sans 9 - bitmap font atlas"
	Name:    pixeloid-9
	Purpose: {
		The Pixeloid Sans font rendered at 9 pixels - crisp, one font pixel is one image pixel -
		as a texture atlas for Rebol-Pugl. Generated from PixeloidSans.ttf by
		font-atlas.py; the atlas is embedded compressed, so no image codec
		is needed.

		    font: make-font do %font/pixeloid-9.reb
	}
	Note: {© 2020-2025 GGBotNet. All Rights Reserved. - This Font Software is licensed under the SIL Open Font License, Version 1.1. This license is available with a FAQ at: https://scripts.sil.org/OFL}
]

make object! [
	name:        "Pixeloid Sans"
	size:        9
	line-height: 13     ;; ascent, descent and the font's line gap
	ascent:      10     ;; from the line's top to the baseline
	descent:     2

